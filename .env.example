# All optional. Nothing here is required: the defaults use keyless public services.
# Never commit a real .env (it is git-ignored).

# Geocoder: "photon" (default, keyless) or "geoapify" (needs a key)
# VITE_GEOCODER=photon
# VITE_GEOAPIFY_KEY=
# VITE_PHOTON_URL=https://photon.komoot.io

# Vector tile index (TileJSON). Default: OpenFreeMap's public planet tiles.
# VITE_TILEJSON_URL=https://tiles.openfreemap.org/planet
